## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated)
mono_crash.*

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2022+ build folders
*.tlog

# Visual Studio cache/options directory
.vs/
.vscode/

# Uncomment if you have tasks that create the project's static files in wwwroot
# wwwroot/

# Rider / JetBrains IDEs
.idea/
*.sln.iml

# NuGet packages
*.nupkg
*.snupkg
*.nuspec
packages/
# Uncomment if necessary
# !packages/build/
# !packages/repositories.config

# Microsoft Azure build output
csx/
*.build.csdef

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Windows image file caches
Thumbs.db
ehthumbs.db

# Others
*.dbmdl
*.bak
*.backup
*.BLOB
*.cache
*.pdb
*.tmp
*.log
*.vspscc
*_i.c
*_p.c
*_h.h
*.pidb
*.svclog
*.scc

# OS generated files
.DS_Store
desktop.ini

# ReSharper / Rider
_ReSharper*/
*.DotSettings.user

# T4 files
*.tt
*.ttinclude
*.ttoutput

# Auto-generated files
Generated_Code/

# Publish folders
publish/
AppPackages/
